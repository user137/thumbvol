<?xml version='1.0' encoding='windows-1252'?>
<!--
  Generated by `cargo wix init`, then hand-edited for thumbvol:

  - Per-user install (InstallScope='perUser') into %LocalAppData%\thumbvol, matching the
    convention already used by the manual install and documented in README.md/CLAUDE.md. No UAC
    elevation needed — this is a personal single-user background tool, not a system service.
  - Minimal UI (WixUI_Minimal), no feature tree: there's exactly one file to install, a feature
    picker adds nothing.
  - "Launch thumbvol" checkbox on the exit dialog: the app self-registers its own autostart entry
    on first run (see main.rs/platform::*::install_autostart), so the installer doesn't duplicate
    that logic — it just offers to trigger it once, the same as running the exe by hand would.
-->

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='thumbvol'
        UpgradeCode='0D17AF29-7A25-4CD5-9256-AC8356B99324'
        Manufacturer='user137'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Lightweight thumb-wheel-to-volume daemon for Logitech MX Master mice (Windows/Linux)'
            Manufacturer='user137'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='thumbvol Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='APPLICATIONFOLDER' Name='thumbvol'>
                    <Component Id='binary0' Guid='A4DDA740-C5C9-438F-9345-C8245443065C'>
                        <!-- Per-user install (ICE38): the KeyPath must be an HKCU registry value,
                             not the file itself, when installing under LocalAppDataFolder. -->
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\thumbvol'
                            Name='Installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                        <File
                            Id='exe0'
                            Name='thumbvol.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\thumbvol.exe'
                            KeyPath='no'/>
                        <!-- ICE64: files under the user profile need an explicit RemoveFolder
                             entry for clean uninstall. -->
                        <RemoveFolder Id='RemoveApplicationFolder' Directory='APPLICATIONFOLDER' On='uninstall'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs thumbvol.'
            Level='1'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/user137/thumbvol'/>

        <!-- Offer to launch thumbvol on exit: this is what triggers the app's own first-run
             autostart registration (HKCU\...\Run), the installer does not write that key itself. -->
        <Property Id='WixShellExecTarget' Value='[#exe0]'/>
        <CustomAction Id='LaunchApplication' BinaryKey='WixCA' DllEntry='WixShellExec' Impersonate='yes'/>

        <UI>
            <UIRef Id='WixUI_Minimal'/>
            <Publish Dialog='ExitDialog' Control='Finish' Event='DoAction' Value='LaunchApplication'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='Launch thumbvol'/>
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1'/>

        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>

    </Product>

</Wix>
